# Candidate-only finite CDC bounds. Flat SDC: TD does not reliably execute
# Tcl procedures/loops in read_sdc. Exact objects are checked by the Tcl driver.
# No clock grouping, no pixel/serial cut, no resolution-stage relaxation.
set_max_delay -from [get_clocks {video_clk}] -to [get_regs {u_composite/pixels/wg_meta[0] u_composite/pixels/wg_meta[1] u_composite/pixels/wg_meta[2] u_pcm_bridge/request_sync[0] u_composite/overflow_sync[0]}] 13.168 -datapath_only
set_max_delay -from [get_clocks {output_pll/pll_inst.clkc[1]}] -to [get_regs {u_composite/pixels/rg_meta[0] u_composite/pixels/rg_meta[1] u_composite/pixels/rg_meta[2] u_pcm_bridge/acknowledge_sync[0] video_timing_data_m0/frame_sync[0] video_timing_data_m0/free_meta[0] video_timing_data_m0/free_meta[1] u_presentation/visible_sync[0] u_scene_control/visible_sync[0]}] 13.168 -datapath_only
set_max_delay -from [get_clocks {ext_mem_clk}] -to [get_regs {video_timing_data_m0/enable_sync[0] u_composite/enable_sync[0]}] 13.168 -datapath_only
set_max_delay -from [get_clocks {output_pll/pll_inst.clkc[1]}] -to [get_regs {video_timing_data_m0/enable_sync[0]}] 13.168 -datapath_only
set_max_delay -from [get_clocks {video_clk}] -to [get_regs {u_pcm_bridge/audio_left[0] u_pcm_bridge/audio_right[0] u_pcm_bridge/audio_left[1] u_pcm_bridge/audio_right[1] u_pcm_bridge/audio_left[2] u_pcm_bridge/audio_right[2] u_pcm_bridge/audio_left[3] u_pcm_bridge/audio_right[3] u_pcm_bridge/audio_left[4] u_pcm_bridge/audio_right[4] u_pcm_bridge/audio_left[5] u_pcm_bridge/audio_right[5] u_pcm_bridge/audio_left[6] u_pcm_bridge/audio_right[6] u_pcm_bridge/audio_left[7] u_pcm_bridge/audio_right[7] u_pcm_bridge/audio_left[8] u_pcm_bridge/audio_right[8] u_pcm_bridge/audio_left[9] u_pcm_bridge/audio_right[9] u_pcm_bridge/audio_left[10] u_pcm_bridge/audio_right[10] u_pcm_bridge/audio_left[11] u_pcm_bridge/audio_right[11] u_pcm_bridge/audio_left[12] u_pcm_bridge/audio_right[12] u_pcm_bridge/audio_left[13] u_pcm_bridge/audio_right[13] u_pcm_bridge/audio_left[14] u_pcm_bridge/audio_right[14] u_pcm_bridge/audio_left[15] u_pcm_bridge/audio_right[15] u_pcm_bridge/audio_left[16] u_pcm_bridge/audio_right[16] u_pcm_bridge/audio_left[17] u_pcm_bridge/audio_right[17] u_pcm_bridge/audio_left[18] u_pcm_bridge/audio_right[18] u_pcm_bridge/audio_left[19] u_pcm_bridge/audio_right[19] u_pcm_bridge/audio_left[20] u_pcm_bridge/audio_right[20] u_pcm_bridge/audio_left[21] u_pcm_bridge/audio_right[21] u_pcm_bridge/audio_left[22] u_pcm_bridge/audio_right[22] u_pcm_bridge/audio_left[23] u_pcm_bridge/audio_right[23]}] 13.168 -datapath_only
# PCM is held until ACK; the last register group is its first data capture.
# FIFO payload slots remain owned until read Gray retirement. Only source
# payload -> RAM DATA is bounded; address/WE/read and later stages retain STA.
set_max_delay -from [get_clocks {video_clk}] -to [get_pins {u_composite/row0/storage.dia[0] u_composite/row0/storage.dia[1] u_composite/row0/storage.dia[2] u_composite/row0/storage.dia[3] u_composite/row0/storage.dia[4] u_composite/row0/storage.dia[5] u_composite/row0/storage.dia[6] u_composite/row0/storage.dia[7] u_composite/row0/storage.dia[8] u_composite/row0/storage.dia[9] u_composite/row0/storage.dia[10] u_composite/row0/storage.dia[11] u_composite/row0/storage.dia[12] u_composite/row0/storage.dia[13] u_composite/row0/storage.dia[14] u_composite/row0/storage.dia[15] u_composite/row0/storage.dib[0] u_composite/row0/storage.dib[1] u_composite/row0/storage.dib[2] u_composite/row0/storage.dib[3] u_composite/row0/storage.dib[4] u_composite/row0/storage.dib[5] u_composite/row0/storage.dib[6] u_composite/row0/storage.dib[7] u_composite/row0/storage.dib[8] u_composite/row1/storage.dia[0] u_composite/row1/storage.dia[1] u_composite/row1/storage.dia[2] u_composite/row1/storage.dia[3] u_composite/row1/storage.dia[4] u_composite/row1/storage.dia[5] u_composite/row1/storage.dia[6] u_composite/row1/storage.dia[7] u_composite/row1/storage.dia[8] u_composite/row1/storage.dia[9] u_composite/row1/storage.dia[10] u_composite/row1/storage.dia[11] u_composite/row1/storage.dia[12] u_composite/row1/storage.dia[13] u_composite/row1/storage.dia[14] u_composite/row1/storage.dia[15] u_composite/row1/storage.dib[0] u_composite/row1/storage.dib[1] u_composite/row1/storage.dib[2] u_composite/row1/storage.dib[3] u_composite/row1/storage.dib[4] u_composite/row1/storage.dib[5] u_composite/row1/storage.dib[6] u_composite/row1/storage.dib[7] u_composite/row1/storage.dib[8]}] 13.168 -datapath_only

# Startup-only title bytes: FAT50MHz can backpressure until a25MHz RAM write
# retires. The payload is held through request synchronization and ACK return.
set_max_delay -from [get_clocks {sd_card_clk}] -to [get_regs {u_title_bridge/req_sync[0]}] 13.168 -datapath_only
set_max_delay -from [get_clocks {video_clk}] -to [get_regs {u_title_bridge/ack_sync[0]}] 13.168 -datapath_only
set_max_delay -from [get_clocks {sd_card_clk}] -to [get_regs {u_title_bridge/title_address[0] u_title_bridge/title_address[1] u_title_bridge/title_address[2] u_title_bridge/title_address[3] u_title_bridge/title_address[4] u_title_bridge/title_address[5] u_title_bridge/title_address[6] u_title_bridge/title_address[7] u_title_bridge/title_data[0] u_title_bridge/title_data[1] u_title_bridge/title_data[2] u_title_bridge/title_data[3] u_title_bridge/title_data[4] u_title_bridge/title_data[5] u_title_bridge/title_data[6]}] 13.168 -datapath_only
# The FIFO SOF bit shares the same held slot as RGB. Its first capture is
# the frame-integrity check; subsequent control paths remain ordinarily timed.
set_max_delay -from [get_clocks {video_clk}] -to [get_regs {u_composite/frame_bad}] 13.168 -datapath_only

# Non-video scene SOF identity. Four owned pixel-FIFO slots hold the tag until
# Gray pointer retirement; only the first tag capture is bounded.
set_max_delay -from [get_clocks {video_clk}] -to [get_regs {u_composite/active_frame_tag[0] u_composite/active_frame_tag[1] u_composite/active_frame_tag[2] u_composite/active_frame_tag[3] u_composite/active_frame_tag[4] u_composite/active_frame_tag[5] u_composite/active_frame_tag[6] u_composite/active_frame_tag[7] u_composite/active_frame_tag[8] u_composite/active_frame_tag[9] u_composite/active_frame_tag[10] u_composite/active_frame_tag[11] u_composite/active_frame_tag[12] u_composite/active_frame_tag[13] u_composite/active_frame_tag[14] u_composite/active_frame_tag[15] u_composite/active_frame_tag[16] u_composite/active_frame_tag[17] u_composite/active_frame_tag[18] u_composite/active_frame_tag[19] u_composite/active_frame_tag[20] u_composite/active_frame_tag[21] u_composite/active_frame_tag[22] u_composite/active_frame_tag[23] u_composite/active_frame_tag[24] u_composite/active_frame_tag[25] u_composite/active_frame_tag[26] u_composite/active_frame_tag[27] u_composite/active_frame_tag[28] u_composite/active_frame_tag[29] u_composite/active_frame_tag[30] u_composite/active_frame_tag[31]}] 13.168 -datapath_only
# SOF toggle and held tag cross output->source domain. The source captures the
# tag only after the toggle synchronizer; compare uses that local register.
set_max_delay -from [get_clocks {output_pll/pll_inst.clkc[1]}] -to [get_regs {u_scene_present_tag/start_sync[0]}] 13.168 -datapath_only
set_max_delay -from [get_clocks {output_pll/pll_inst.clkc[1]}] -to [get_regs {u_scene_present_tag/captured_start_tag[0] u_scene_present_tag/captured_start_tag[1] u_scene_present_tag/captured_start_tag[2] u_scene_present_tag/captured_start_tag[3] u_scene_present_tag/captured_start_tag[4] u_scene_present_tag/captured_start_tag[5] u_scene_present_tag/captured_start_tag[6] u_scene_present_tag/captured_start_tag[7] u_scene_present_tag/captured_start_tag[8] u_scene_present_tag/captured_start_tag[9] u_scene_present_tag/captured_start_tag[10] u_scene_present_tag/captured_start_tag[11] u_scene_present_tag/captured_start_tag[12] u_scene_present_tag/captured_start_tag[13] u_scene_present_tag/captured_start_tag[14] u_scene_present_tag/captured_start_tag[15] u_scene_present_tag/captured_start_tag[16] u_scene_present_tag/captured_start_tag[17] u_scene_present_tag/captured_start_tag[18] u_scene_present_tag/captured_start_tag[19] u_scene_present_tag/captured_start_tag[20] u_scene_present_tag/captured_start_tag[21] u_scene_present_tag/captured_start_tag[22] u_scene_present_tag/captured_start_tag[23] u_scene_present_tag/captured_start_tag[24] u_scene_present_tag/captured_start_tag[25] u_scene_present_tag/captured_start_tag[26] u_scene_present_tag/captured_start_tag[27] u_scene_present_tag/captured_start_tag[28] u_scene_present_tag/captured_start_tag[29] u_scene_present_tag/captured_start_tag[30] u_scene_present_tag/captured_start_tag[31]}] 13.168 -datapath_only

# Cache bank bundle: first capture only; later stages retain ordinary STA.
set_max_delay -from [get_clocks {video_clk}] -to [get_regs {frame_read_write_m0/frame_fifo_read_m0/read_addr_index_d0[1] frame_read_write_m0/frame_fifo_read_m0/read_addr_index_d0[2]}] 20.000 -datapath_only
